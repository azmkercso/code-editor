+import { Application, Logger } from '../../../../automation';
+import { installAllHandlers } from '../../utils';
+
+export function setup(logger: Logger) {
+	describe('Code Editor - Settings Configuration', () => {
+
+		installAllHandlers(logger);
+
+		it('telemetry setting should be OFF with no other options', async function () {
+			const app = this.app as Application;
+			await app.workbench.settingsEditor.searchSettingsUI('telemetry.telemetryLevel');
+			const settingControl = await app.code.waitForElement('.settings-editor .setting-item-contents .setting-item-control select');
+			if (settingControl) {
+				const text = settingControl.textContent.toLowerCase();
+				if (!text.includes('off')) {
+					throw new Error(`Telemetry setting should be "off", got: ${settingControl.textContent}`);
+				}
+			}
+		});
+
+		it('update mode should be "none"', async function () {
+			const app = this.app as Application;
+			await app.workbench.settingsEditor.searchSettingsUI('update.mode');
+			const settingControl = await app.code.waitForElement('.settings-editor .setting-item-contents .setting-item-control select');
+			if (settingControl) {
+				const text = settingControl.textContent.toLowerCase();
+				if (!text.includes('none')) {
+					throw new Error(`Update mode should be "none", got: ${settingControl.textContent}`);
+				}
+			}
+		});
+
+		it('chat settings should be excluded from settings UI', async function () {
+			const app = this.app as Application;
+			// Search by setting ID prefix to avoid false positives from full-text matches
+			await app.workbench.settingsEditor.searchSettingsUI('@id:chat.');
+			await new Promise(resolve => setTimeout(resolve, 3000));
+			const items = await app.code.getElements('.settings-editor .setting-item-bool, .settings-editor .setting-item-text, .settings-editor .setting-item-enum', false);
+			if (items && items.length > 0) {
+				throw new Error(`Expected no chat.* settings by ID, but found ${items.length} setting items`);
+			}
+
+			// Also verify accessibility chat settings are excluded
+			await app.workbench.settingsEditor.searchSettingsUI('@id:accessibility.chat');
+			await new Promise(resolve => setTimeout(resolve, 2000));
+			const accessibilityItems = await app.code.getElements('.settings-editor .setting-item-bool, .settings-editor .setting-item-text, .settings-editor .setting-item-enum', false);
+			if (accessibilityItems && accessibilityItems.length > 0) {
+				throw new Error(`Expected no accessibility.chat* settings, but found ${accessibilityItems.length} setting items`);
+			}
+
+			// Verify a normal setting still works
+			await app.workbench.settingsEditor.searchSettingsUI('editor.fontSize');
+			await app.code.waitForElement('.settings-editor .setting-item-contents');
+		});
+	});
+}
