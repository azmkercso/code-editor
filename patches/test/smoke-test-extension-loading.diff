+import * as path from 'path';
+import * as fs from 'fs';
+import { Application, Logger } from '../../../../automation';
+import { installAllHandlers } from '../../utils';
+
+export function setup(logger: Logger) {
+	describe('Code Editor - Extension Loading', () => {
+
+		installAllHandlers(logger);
+
+		it('markdown preview extension activates and renders content', async function () {
+			this.timeout(60_000);
+			const app = this.app as Application;
+
+			// Create a markdown file with known content
+			const mdFile = path.join(app.workspacePathOrFolder, 'test-preview.md');
+			fs.writeFileSync(mdFile, '# Hello Markdown\n\nThis is a **test** paragraph.\n');
+
+			// Open the file
+			await app.workbench.quickaccess.openFile(mdFile);
+			await app.workbench.editors.waitForActiveEditor('test-preview.md');
+
+			// Open markdown preview to the side
+			await app.workbench.quickaccess.runCommand('markdown.showPreviewToSide');
+
+			// Wait for the webview iframe to appear in the DOM
+			const page = app.code.driver.currentPage;
+			await page.locator('iframe.webview.ready').first().waitFor({ state: 'attached', timeout: 15000 });
+
+			// Access the nested iframe structure: outer webview → inner active-frame
+			const webviewFrame = page.frameLocator('iframe.webview.ready').first();
+			const innerFrame = webviewFrame.frameLocator('#active-frame');
+
+			// Verify the rendered content contains our heading
+			await innerFrame.locator('h1', { hasText: 'Hello Markdown' }).waitFor({ state: 'visible', timeout: 30000 });
+
+			logger.log('Markdown preview rendered correctly in webview iframe');
+
+			// Clean up
+			fs.unlinkSync(mdFile);
+		});
+
+		it('TypeScript language features activate for JS files', async function () {
+			this.timeout(60_000);
+			const app = this.app as Application;
+
+			// Create a JS file with a type error to trigger diagnostics
+			const jsFile = path.join(app.workspacePathOrFolder, 'test-ts-extension.js');
+			fs.writeFileSync(jsFile, '// @ts-check\n/** @type {number} */\nconst x = "not a number";\n');
+
+			// Open the file
+			await app.workbench.quickaccess.openFile(jsFile);
+			await app.workbench.editors.waitForActiveEditor('test-ts-extension.js');
+
+			// Wait for TypeScript to activate and produce diagnostics (squiggly line)
+			// The .squiggly-error or .squiggly-warning class appears when TS reports issues
+			await app.code.waitForElement('.view-overlays .squiggly-error, .view-overlays .squiggly-warning', undefined, 60);
+
+			logger.log('TypeScript diagnostics rendered — TypeScript language features extension is functional');
+
+			// Clean up
+			fs.unlinkSync(jsFile);
+		});
+	});
+}
