+import { Logger } from '../../../../automation';
+import { installAllHandlers } from '../../utils';
+import { setup as setupSageMakerExtensionsInstallTests } from './sagemaker-extensions-install.test';
+import { setup as setupSageMakerIdleExtensionTests } from './sagemaker-idle-extension.test';
+import { setup as setupSageMakerDarkThemeTests } from './sagemaker-dark-theme.test';
+
+const target = process.env.CODE_EDITOR_TARGET || '';
+const isSagemaker = target.includes('sagemaker');
+
+export function setup(logger: Logger) {
+	describe('SageMaker Extensions', function () {
+		before(function () {
+			if (!isSagemaker) { this.skip(); return; }
+		});
+
+		// Shared before/after handling
+		installAllHandlers(logger);
+
+		setupSageMakerExtensionsInstallTests();
+		setupSageMakerIdleExtensionTests();
+		setupSageMakerDarkThemeTests();
+	});
+}
