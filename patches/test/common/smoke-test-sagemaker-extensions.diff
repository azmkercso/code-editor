+
+import { Application } from '../../../../automation';
+
+export function setup() {
+	describe('Dark Theme', () => {
+		it('should have correct theme on startup', async function () {
+			const app = this.app as Application;
+
+			// Open color theme picker without auto-selecting
+			await new Promise<void>(resolve => setTimeout(resolve, 3000));
+			await app.workbench.quickaccess.runCommand('workbench.action.selectTheme', { keepOpen: true });
+
+			// Wait for quick input to open
+			await app.workbench.quickinput.waitForQuickInputOpened();
+			await new Promise<void>(resolve => setTimeout(resolve, 1000));
+			// Get the focused theme (currently selected)
+			const focusedTheme = await app.code.waitForElement('.quick-input-widget .quick-input-list .monaco-list-row.focused .monaco-highlighted-label');
+			const selectedTheme = focusedTheme.textContent;
+
+			// Close quick input
+			await app.workbench.quickinput.closeQuickInput();
+
+			if (process.env.SERVICE_NAME === 'SageMakerUnifiedStudio') {
+				// With SERVICE_NAME set, the extension should activate and set a dark theme
+				if (!selectedTheme.toLowerCase().includes('dark')) {
+					throw new Error(`Expected dark theme when SERVICE_NAME=SageMakerUnifiedStudio, got: ${selectedTheme}`);
+				}
+			} else {
+				// Without SERVICE_NAME, the extension should NOT change the theme (stays default)
+				if (selectedTheme.toLowerCase().includes('sagemaker')) {
+					throw new Error(`Expected default theme without SERVICE_NAME, got SageMaker theme: ${selectedTheme}`);
+				}
+			}
+		});
+	});
+}
