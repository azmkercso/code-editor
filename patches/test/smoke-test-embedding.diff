+<!DOCTYPE html>
+<html>
+<head><title>Code Editor Embedding Test Harness</title></head>
+<body>
+<script>
+  window.__testMessages = [];
+  window.addEventListener('message', function(event) {
+    if (event.data && typeof event.data === 'object') {
+      window.__testMessages.push(event.data);
+    }
+  });
+  window.__sendToEditor = function(msg) {
+    var iframe = document.getElementById('editor');
+    if (iframe && iframe.contentWindow) {
+      iframe.contentWindow.postMessage(msg, '*');
+    }
+  };
+  var params = new URLSearchParams(window.location.search);
+  var editorUrl = params.get('editorUrl');
+  if (editorUrl) {
+    var iframe = document.createElement('iframe');
+    iframe.id = 'editor';
+    iframe.src = editorUrl;
+    iframe.style.cssText = 'width:100%;height:100vh;border:none;';
+    document.body.appendChild(iframe);
+  }
+</script>
+</body>
+</html>
