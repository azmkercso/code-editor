+import { Application, Logger } from '../../../../automation';
+import { installAllHandlers } from '../../utils';
+
+const target = process.env.CODE_EDITOR_TARGET || '';
+const isWebEmbedded = target.includes('web-embedded');
+
+export function setup(logger: Logger) {
+	describe('Code Editor - Removed Features', () => {
+
+		// Shared before/after handling
+		installAllHandlers(logger);
+
+		it('should not have Accounts icon in activity bar', async function () {
+			const app = this.app as Application;
+			const elements = await app.code.getElements('.activitybar .actions-container a[aria-label="Accounts"]', false);
+			if (elements && elements.length > 0) {
+				throw new Error('Accounts icon should not be present in activity bar');
+			}
+		});
+
+		it('should not have SCM viewlet in activity bar', async function () {
+			const app = this.app as Application;
+			const commands = await app.workbench.quickaccess.getVisibleCommandNames('View: Show Source Control');
+			if (commands.some(c => c === 'View: Show Source Control')) {
+				throw new Error('Source Control view command should not be available');
+			}
+		});
+
+		it('should not have Terminal command available (web-embedded only)', async function () {
+			if (!isWebEmbedded) { this.skip(); return; }
+			const app = this.app as Application;
+			const commands = await app.workbench.quickaccess.getVisibleCommandNames('Terminal: Create New');
+			if (commands.some(c => c.startsWith('Terminal: Create New'))) {
+				throw new Error('Terminal commands should not be available');
+			}
+		});
+
+		it('should not have merge conflict commands (web-embedded only)', async function () {
+			if (!isWebEmbedded) { this.skip(); return; }
+			const app = this.app as Application;
+			const commands = await app.workbench.quickaccess.getVisibleCommandNames('Merge Conflict');
+			if (commands.some(c => c.includes('Merge Conflict'))) {
+				throw new Error('Merge Conflict commands should not be available');
+			}
+		});
+
+		it('should not have call hierarchy commands (web-embedded only)', async function () {
+			if (!isWebEmbedded) { this.skip(); return; }
+			const app = this.app as Application;
+			const commands = await app.workbench.quickaccess.getVisibleCommandNames('Call Hierarchy');
+			if (commands.some(c => c.includes('Call Hierarchy'))) {
+				throw new Error('Call Hierarchy commands should not be available');
+			}
+		});
+
+		it('should not have Save As command (web-embedded only)', async function () {
+			if (!isWebEmbedded) { this.skip(); return; }
+			const app = this.app as Application;
+			const commands = await app.workbench.quickaccess.getVisibleCommandNames('File: Save As');
+			if (commands.some(c => c === 'File: Save As...')) {
+				throw new Error('Save As command should not be available');
+			}
+		});
+
+		it('should not have chat commands', async function () {
+			const app = this.app as Application;
+			const unexpectedFound: string[] = [];
+			for (const term of ['Chat:', 'Copilot:']) {
+				const commands = await app.workbench.quickaccess.getVisibleCommandNames(term);
+				for (const command of commands) {
+					if (command.includes('Chat') || command.includes('Copilot')) {
+						unexpectedFound.push(command);
+					}
+				}
+			}
+			if (unexpectedFound.length > 0) {
+				throw new Error(`Chat/Copilot commands should not be available: ${unexpectedFound.join(', ')}`);
+			}
+		});
+
+		it('should not have New Window command (web-embedded only)', async function () {
+			if (!isWebEmbedded) { this.skip(); return; }
+			const app = this.app as Application;
+			const commands = await app.workbench.quickaccess.getVisibleCommandNames('New Window');
+			if (commands.some(c => c === 'New Window')) {
+				throw new Error('New Window command should not be available');
+			}
+		});
+
+		it('should not have Continue Edit Session command', async function () {
+			const app = this.app as Application;
+			const commands = await app.workbench.quickaccess.getVisibleCommandNames('Continue Edit Session');
+			if (commands.some(c => c.includes('Continue Edit Session'))) {
+				throw new Error('Continue Edit Session command should not be available');
+			}
+		});
+
+		it('should not have user tasks commands', async function () {
+			const app = this.app as Application;
+			const commands = await app.workbench.quickaccess.getVisibleCommandNames('Tasks: Configure User Tasks');
+			if (commands.some(c => c === 'Tasks: Configure User Tasks')) {
+				throw new Error('User Tasks command should not be available');
+			}
+		});
+
+		it('should not have SSH remote host', async function () {
+			const app = this.app as Application;
+			const commands = await app.workbench.quickaccess.getVisibleCommandNames('Remote-SSH');
+			if (commands.some(c => c.includes('Remote-SSH'))) {
+				throw new Error('Remote-SSH commands should not be available');
+			}
+		});
+
+		it('should not show built-in walkthroughs on startup', async function () {
+			const app = this.app as Application;
+			const elements = await app.code.getElements('.getting-started-category', false);
+			if (elements && elements.length > 0) {
+				throw new Error('Built-in walkthroughs should not be shown');
+			}
+		});
+
+		it('should not have profile import/export in menus (web-embedded only)', async function () {
+			if (!isWebEmbedded) { this.skip(); return; }
+			const app = this.app as Application;
+			const commands = await app.workbench.quickaccess.getVisibleCommandNames('Import Profile');
+			const hasImport = commands.some(c => c.includes('Import Profile'));
+			const exportCommands = await app.workbench.quickaccess.getVisibleCommandNames('Export Profile');
+			const hasExport = exportCommands.some(c => c.includes('Export Profile'));
+			if (hasImport || hasExport) {
+				throw new Error('Profile import/export commands should not be available');
+			}
+		});
+
+		it('should have debug service registered', async function () {
+			const app = this.app as Application;
+			const commands = await app.workbench.quickaccess.getVisibleCommandNames('Debug: ');
+			if (!commands.some(c => c.includes('Debug'))) {
+				throw new Error('Debug commands not available — IDebugService may not be registered');
+			}
+		});
+	});
+}
